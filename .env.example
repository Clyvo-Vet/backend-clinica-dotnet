# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env.
#
# O docker-compose.yml usa ${VAR:?...} em todas estas variaveis: se faltar
# qualquer uma, o Compose ABORTA com a mensagem em vez de subir o container
# com valor vazio. Isso e proposital -- ver o cabecalho do docker-compose.yml.

# --- Oracle ---
# ORACLE_DATA_SOURCE NAO tem default. Aponte para o Oracle local do DevOps-Cloud
# (localhost:9092/XEPDB1). Apontar para oracle.fiap.com.br e infraestrutura
# compartilhada VIVA: credencial errada gera ORA-01017 a cada tentativa, e
# ORA-01017 repetido trava a conta com ORA-28000. Ja aconteceu neste projeto.
ORACLE_APP_USER=<YOUR_ORACLE_USER>
ORACLE_PASSWORD=<YOUR_ORACLE_PASSWORD>
ORACLE_DATA_SOURCE=localhost:9092/XEPDB1

# --- Segredos da aplicacao ---
# JWT_KEY assina HS256: minimo 256 bits. Gere com `openssl rand -base64 48`.
JWT_KEY=<YOUR_JWT_SECRET_MIN_32_CHARS>
IOT_API_KEY=<YOUR_IOT_API_KEY>
LUNA_API_KEY=<YOUR_LUNA_API_KEY>
DAILY_API_KEY=<YOUR_DAILY_CO_API_KEY>
LUNA_BASE_URL=http://localhost:8000
LUNA_INBOUND_API_KEY=<SAME_VALUE_AS_LUNA_INBOUND_API_KEY_IN_KURA-LUNA-AI>

# Opcional -- pasta onde os PDFs de receituario sao salvos (Documento.DsCaminho).
# Padrao se ausente: <diretorio da app>/storage/documentos
STORAGE_BASE_PATH=
