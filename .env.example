# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env.

ORACLE_PASSWORD=<YOUR_ORACLE_PASSWORD>
JWT_KEY=<YOUR_JWT_SECRET_MIN_32_CHARS>
IOT_API_KEY=<YOUR_IOT_API_KEY>
LUNA_API_KEY=<YOUR_LUNA_API_KEY>
DAILY_API_KEY=<YOUR_DAILY_CO_API_KEY>
LUNA_BASE_URL=http://localhost:8000
LUNA_INBOUND_API_KEY=<SAME_VALUE_AS_LUNA_INBOUND_API_KEY_IN_KURA-LUNA-AI>
# Opcional — pasta onde os PDFs de receituário são salvos (Documento.DsCaminho).
# Padrão se ausente: <diretório da app>/storage/documentos
STORAGE_BASE_PATH=
